# Database: Neon Postgres.
#
# In production the Worker reads the connection string from its Hyperdrive
# binding (see wrangler.jsonc), which pools connections at the edge. Locally,
# and for any script, set DATABASE_URL to the Neon connection string directly.
#
DATABASE_URL=

# This app's JWT signing key. Generate with `openssl rand -base64 32`. It is
# not shared with anything and does not need to match any other app.
AUTH_SECRET=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required off Vercel, so required now. Auth.js rejects requests it cannot
# attribute to a known host, and without one of these EVERY sign-in fails with
# UntrustedHost. Set AUTH_URL to the deployed origin.
AUTH_URL=
AUTH_TRUST_HOST=

# Site analysis.
# VerifiedDR returns both Ahrefs DR and their TrueDR from one lookup. The key is
# a bearer token (it starts with "vdr_") and the plan carries a monthly quota, so
# every submission spends one call. Leaving it unset degrades gracefully:
# submissions still work, they just carry no scores (null DR and null TrueDR).
OPENROUTER_API_KEY=
OPENROUTER_ANALYZE_MODEL=deepseek/deepseek-v4-flash
VERIFIEDDR_API_KEY=

# Email (SES). No inbound: the relay is dropped, no MX needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
EMAIL_FROM=

# Analytics needs no key. The site is registered with Cloudflare Web Analytics
# on "Automatic setup": the JS Snippet will be automatically injected at the
# edge, so there is no beacon token to configure and nothing for the app to
# render. There is deliberately no NEXT_PUBLIC_CF_BEACON_TOKEN here.
#
# If you ever switch the site to "Enable with JS Snippet installation" in
# Web Analytics -> Manage site, Cloudflare issues a token and you have to render
# the script yourself again. Only one mode at a time: running both double-counts
# every pageview.

CRON_SECRET=

# Where the two end-to-end suites point. Both default to http://localhost:3100,
# so these are only needed to aim at something else — most usefully the real
# runtime, which is the one that matters:
#
#   pnpm exec opennextjs-cloudflare build
#   pnpm exec wrangler dev --port 8788 --test-scheduled
#   MCP_SMOKE_BASE=http://localhost:8788 pnpm test:mcp
#
# `pnpm test:cron` reads CRON_SECRET above as well, and REFUSES any host that is
# not localhost: its live half proposes real matches and sends real email.
MCP_SMOKE_BASE=
CRON_SMOKE_BASE=

# The inbox suites. `pnpm test:inbox` drives the /api/inbox routes over HTTP and
# `pnpm test:e2e` drives the UI in a real browser; both seed their own fixtures
# and both sign in by minting a session JWT with AUTH_SECRET above, so that has
# to be set for them to run at all.
INBOX_SMOKE_BASE=
E2E_BASE_URL=

# Cloudflare deploy credentials. CI ONLY: `wrangler login` covers a local
# deploy, and the Worker itself never reads either of these.
#
# The token needs TWO policies, because this deploy spans both scopes. Getting
# only the first is the usual mistake: Workers permissions are account-level, so
# a token scoped to "Specified Domains" cannot upload a Worker at all.
#
#   Account  -> Workers Scripts : Edit   (the script, its assets, cron triggers)
#   Account  -> Account Settings : Read  (lets wrangler resolve the account)
#   Zone     -> Workers Routes : Edit    (on builders-backlinks.com only)
#
# That last one is needed solely because wrangler.jsonc binds the apex domain
# via `routes`. Without it the deploy fails at the route step, after the script
# has already uploaded, which reads as a half-applied deploy.
#
# The stock "Edit Cloudflare Workers" template also works and is what most
# people use. It grants more than the above (KV, R2, D1), none of which this app
# binds: open-next.config.ts is a bare defineCloudflareConfig().
#
# Hyperdrive needs no token permission here. The binding is an id reference
# resolved at deploy time, and the config itself is created once by hand.
CLOUDFLARE_API_TOKEN=
# Workers & Pages -> right-hand sidebar of the account overview.
CLOUDFLARE_ACCOUNT_ID=

# Who can reach /admin and approve listings. Comma separated, matched
# case-insensitively against the signed-in account's email.
#
# Leave it empty and nobody gets in, including you: the gate fails closed, the
# same way the cron bearer check does. There is no admin flag in the database
# and no way to grant one from inside the app, so this variable is the whole
# access control mechanism. Nothing can be matched until at least one address
# here approves the first listings.
ADMIN_EMAILS=

NEXT_PUBLIC_SITE_URL=https://builders-backlinks.com

# GA4. Leave EMPTY locally: unset means the tag never loads and every analytics
# helper no-ops, which is what keeps local traffic out of the real property.
NEXT_PUBLIC_GA_ID=