# Shared with nicklaunches.com: same cluster, same users/accounts collections.
MONGODB_URI=
MONGODB_DB=

# Must match nicklaunches.com so a user resolves to the same _id on both sides.
AUTH_SECRET=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cross-domain handoff (nicklaunches.com <-> builders-backlinks.com)
HANDOFF_SECRET=
BRIDGE_SECRET=
NL_BASE_URL=https://nicklaunches.com

# Site analysis
OPENROUTER_API_KEY=
AHREFS_API_KEY=

# Email (SES). No inbound: the relay is dropped, no MX needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
EMAIL_FROM=

CRON_SECRET=
ADMIN_EMAILS=
NEXT_PUBLIC_SITE_URL=https://builders-backlinks.com
