{
    "name": "builders-backlinks",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "format": "prettier . --write",
        "mcp:inspect": "npx @modelcontextprotocol/inspector",
        "test": "node --import tsx --test \"src/**/*.test.ts\"",
        "test:mcp": "node --import tsx scripts/mcp-smoke.ts",
        "emails:render": "node --import tsx scripts/render-emails.ts",
        "assets:generate": "node --import tsx scripts/assets/generate.ts",
        "assets:post": "node --import tsx scripts/assets/post-card.ts",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "pnpm db:migrate:deploy && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "cf-typegen": "wrangler types",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:migrate:deploy": "node --import tsx scripts/assert-prod-db.ts && drizzle-kit migrate"
    },
    "dependencies": {
        "@auth/drizzle-adapter": "^1.11.3",
        "@modelcontextprotocol/sdk": "1.29.0",
        "@modelcontextprotocol/server": "2.0.0-beta.5",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.0.8",
        "agents": "^0.20.0",
        "aws4fetch": "^1.0.20",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "lucide-react": "^1.11.0",
        "next": "16.2.12",
        "next-auth": "5.0.0-beta.32",
        "postgres": "^3.4.9",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "tailwind-merge": "^3.5.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.20.2",
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/postcss": "^4",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9",
        "eslint-config-next": "16.2.4",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.7.3",
        "tailwindcss": "^4",
        "tsx": "^4.21.0",
        "typescript": "^5",
        "wrangler": "^4.114.0"
    },
    "packageManager": "pnpm@10.33.4",
    "pnpm": {
        "onlyBuiltDependencies": [
            "workerd",
            "esbuild",
            "sharp",
            "unrs-resolver"
        ]
    }
}
