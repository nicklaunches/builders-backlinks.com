node_modules/
.next/
.vercel/
.env
.env.*
!.env.example
*.tsbuildinfo
next-env.d.ts
.DS_Store
.render/
.dev.vars

# Generated by opennextjs-cloudflare build.
.open-next

# Miniflare's local state for `wrangler dev`: caches, KV and DO storage.
# Machine-local and disposable, and deleting it just costs a cold first request.
.wrangler/

# worker-configuration.d.ts is NOT ignored. It is generated by `wrangler types`
# from wrangler.jsonc, but src/lib/db/index.ts depends on the `Env` it declares
# (via CloudflareEnv in open-next-worker.d.ts), so `tsc --noEmit` fails without
# it. CI type-checks a clean checkout before it ever builds, which means the
# file has to be committed. Regenerate with `pnpm cf-typegen` after changing a
# binding in wrangler.jsonc.

# Typeface fetched by scripts/assets/generate.ts on first run. Not vendored:
# JetBrains Mono is OFL, and a font binary in the repo is a licence obligation
# nobody remembers. Delete this directory to force a re-fetch.
scripts/assets/.fonts/

# Local fixtures written by scripts/seed-inbox.ts. Contains session cookies
# for seeded members, valid only against a local AUTH_SECRET.
.seed/

# Playwright output. Traces are uploaded from CI on failure, never committed.
test-results/
playwright-report/
